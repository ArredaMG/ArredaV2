                className="w-80 flex-shrink-0 flex flex-col bg-white dark:bg-[#1C1C1E] border border-gray-200 dark:border-gray-800 rounded-2xl max-h-[calc(100vh-270px)] shadow-sm transition-all duration-200 h-full relative"
